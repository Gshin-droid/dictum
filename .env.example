# Настройки диктовки. Файл необязателен: без него работают значения по умолчанию.
# Всё это меняется правой кнопкой по значку в лотке — руками править не обязательно.
# Чтобы задать вручную: скопировать в файл с именем .env рядом с программой.

# Модель распознавания. Три проверенных варианта:
#   gigaam-v3-e2e-rnnt            русский, сам ставит знаки препинания   (по умолчанию)
#   gigaam-multilingual-ctc       + казахский, киргизский, узбекский; знаков препинания НЕТ
#   gigaam-multilingual-large-ctc те же языки, точнее и вдвое тяжелее
ASR_MODEL=gigaam-v3-e2e-rnnt

# Клавиша начала и остановки записи
VOICE_HOTKEY=f8

# Сохранять ли копии диктовок в data/dictation (звук + текст).
# Нужно, только чтобы сравнивать модели на одном и том же звуке. ~2 МБ на минуту речи.
VOICE_SAVE_SAMPLES=0

# Чувствительность волны в окне. Полоски вялые — поднять, зашкаливают — опустить.
# На распознавание не влияет, только на картинку.
VOICE_GAIN=2.2
